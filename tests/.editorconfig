# Test projects relax library-only rules.
[*.cs]

# ConfigureAwait(false) is not required in test code.
dotnet_diagnostic.CA2007.severity = none

# xUnit test methods are named MethodName_Scenario_ExpectedBehavior (underscores intended).
dotnet_diagnostic.CA1707.severity = none

# Tests may instantiate types without using all members.
dotnet_diagnostic.CA1812.severity = none
