<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />
    <!-- OpenAI is held at the version Microsoft.Extensions.AI.OpenAI 10.10.0 compiles against. Its nuspec now declares an
         open floor (OpenAI >= 2.13.0), but the Responses surface is still [Experimental("OPENAI001")] and OpenAI 2.14.0
         renames experimental types that the 10.10.0 assembly references by name
         (OpenAI.Responses.GlobalMcpToolCallApprovalPolicy -> DefaultMcpToolCallApprovalPolicy), so floating above 2.13.0
         risks a TypeLoadException on the Responses tool path at run time. Bump OpenAI only together with a
         Microsoft.Extensions.AI.OpenAI release built against the newer OpenAI. -->
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

</Project>
