<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.24.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />
    <!-- OpenAI is held at the version Microsoft.Extensions.AI.OpenAI 10.10.1 compiles against (its nuspec floor, 2.14.0).
         The Responses surface is [Experimental("OPENAI001")] and OpenAI minors rename experimental types that
         Microsoft.Extensions.AI.OpenAI references by name (2.14.0 renamed GlobalMcpToolCallApprovalPolicy to
         DefaultMcpToolCallApprovalPolicy, which made 10.10.0 throw TypeLoadException on the Responses tool path), so
         floating above that version risks the same failure at run time. Bump OpenAI only together with a
         Microsoft.Extensions.AI.OpenAI release built against the newer OpenAI. -->
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

</Project>
