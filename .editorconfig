root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{json,yml,yaml}]
indent_size = 2

[*.{props,targets,csproj,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# Namespaces
csharp_style_namespace_declarations = file_scoped:error
dotnet_style_namespace_match_folder = false

# Braces and newlines
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = true:warning

# using directives
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:error

# Null checking
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:error
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning

# Expression preferences
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = false
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error

# nameof
dotnet_diagnostic.CA1507.severity = error

# ConfigureAwait(false) in library code (relaxed for tests via nested .editorconfig)
dotnet_diagnostic.CA2007.severity = error

# Naming: interfaces prefixed with I
dotnet_naming_rule.interfaces_begin_with_i.severity = error
dotnet_naming_rule.interfaces_begin_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_begin_with_i.style = prefix_interface_with_i

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *

dotnet_naming_style.prefix_interface_with_i.capitalization = pascal_case
dotnet_naming_style.prefix_interface_with_i.required_prefix = I

# Naming: types and public members PascalCase
dotnet_naming_rule.types_pascal_case.severity = error
dotnet_naming_rule.types_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_pascal_case.style = pascal_case_style

dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_symbols.type_symbols.applicable_accessibilities = public, internal, protected, protected_internal

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Naming: private fields camelCase with underscore prefix
dotnet_naming_rule.private_fields_underscore_camel.severity = error
dotnet_naming_rule.private_fields_underscore_camel.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore_camel.style = underscore_camel_case

dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_field_symbols.required_modifiers =

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
